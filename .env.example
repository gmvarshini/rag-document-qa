# Copy this file to .env and adjust the values for your local setup.

# Name of the local Ollama model used to generate answers.
# Pull it first with: ollama pull llama3.2
OLLAMA_MODEL=llama3.2

# Maximum number of characters per document chunk.
CHUNK_SIZE=500

# Number of overlapping characters shared between consecutive chunks.
CHUNK_OVERLAP=50

# Directory where the FAISS vector store index is saved.
VECTOR_STORE_PATH=./vector_store

# Number of top matching chunks retrieved for each query.
TOP_K_RESULTS=4

# Local sentence-transformers model used to embed text.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
